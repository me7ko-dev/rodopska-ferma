// Родопска ферма — онлайн сървър (Cloudflare Worker + D1).
// Пускане локално: npx wrangler dev -c server/wrangler.jsonc
// Качване:        npx wrangler deploy -c server/wrangler.jsonc
// База:           npx wrangler d1 execute rodopska-ferma --remote -c server/wrangler.jsonc --file server/schema.sql
{
  "name": "rodopska-ferma-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // адресът на сървъра (поддомейн на metko.uk в същия Cloudflare профил)
  "routes": [{ "pattern": "ferma-api.metko.uk", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "rodopska-ferma", "database_id": "e6ff35ff-d5e4-4f1b-b19d-a345f58946be" }
  ]
}
